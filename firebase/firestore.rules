rules_version = '2';

// Modèle : chaque document métier (animal, zone, collier, alerte...)
// porte un champ ownerId = uid de l'éleveur propriétaire.
// Un utilisateur ne peut lire/écrire que SES propres données.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(resourceOwnerId) {
      return isSignedIn() && request.auth.uid == resourceOwnerId;
    }

    // Profil utilisateur
    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Animaux
    match /animals/{animalId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Zones virtuelles
    match /zones/{zoneId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Colliers GPS
    match /collars/{collarId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Positions GPS (écrites par le collier via une Cloud Function ou clé API dédiée)
    match /locations/{locationId} {
      allow read: if isOwner(resource.data.ownerId);
      allow write: if isSignedIn(); // à restreindre côté Cloud Function pour le collier
    }

    // Alertes
    match /alerts/{alertId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn();
    }

    // Historique
    match /history/{historyId} {
      allow read: if isOwner(resource.data.ownerId);
      allow write: if isSignedIn();
    }

    // Paramètres du collier
    match /settings/{settingId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
